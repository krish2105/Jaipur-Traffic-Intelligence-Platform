# ─────────────────────────────────────────────────────────────────────────────
# PRAVAAH — environment. Copy to .env. NEVER commit .env.
# Secrets in production live in Render env groups / state KMS, never in files
# and never in the repo (docs/07 §5 Cryptography).
# ─────────────────────────────────────────────────────────────────────────────

# --- source mode -------------------------------------------------------------
# replay  = every adapter resolves to its file-backed implementation.
#           The whole system runs with the network cable pulled (docs/05 §4).
# live    = live adapters where credentials exist, replay fallback where not.
PRAVAAH_SOURCE_MODE=replay
PRAVAAH_ENV=development

# --- database (Tiger Cloud / local Timescale) --------------------------------
DATABASE_URL=postgresql+asyncpg://pravaah:pravaah@localhost:5433/pravaah
# Read-only role used by NEETI text-to-SQL. Allowlisted schema, no DDL/DML.
DATABASE_URL_READONLY=postgresql+asyncpg://pravaah_ro:pravaah_ro@localhost:5433/pravaah
DB_STATEMENT_TIMEOUT_MS=5000
DB_ROW_CAP=10000

# --- event bus ---------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- object store (R2 in cloud, MinIO offline) -------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_EVIDENCE=pravaah-evidence
S3_BUCKET_ARTEFACTS=pravaah-artefacts
S3_BUCKET_TILES=pravaah-tiles
S3_PRESIGN_TTL_SECONDS=300

# --- identity (Keycloak) -----------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=pravaah
KEYCLOAK_CLIENT_ID=pravaah-web
KEYCLOAK_CLIENT_SECRET=change-me
OIDC_AUDIENCE=pravaah-api

# --- P2 encryption (docs/07 §3) ----------------------------------------------
# KEK is separate from the DEK and, in production, lives in Vault or the state
# KMS — never in an env var. This is a development placeholder only.
PLATE_KEK_BASE64=
PLATE_HASH_SALT=
REID_SALT_ROTATION_HOURS=24

# --- external data sources (docs plan §6) ------------------------------------
TOMTOM_API_KEY=
DATA_GOV_IN_API_KEY=
OVERPASS_URL=https://overpass-api.de/api/interpreter
ENABLE_WEATHER_ADAPTER=false          # Open-Meteo, keyless; off by default
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# --- LLM (docs/DECISIONS.md ADR-008) -----------------------------------------
LLM_PROVIDER=gemini                   # gemini | groq | ollama | anthropic
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# --- demo mode (build-gated; must be false in production) --------------------
DEMO_MODE=true
DEMO_ROLE_SWITCHER=true
DEMO_GUIDED_TOUR=true
DEMO_TIME_TRAVEL=true

# --- frontend (apps/web) -----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws/live
NEXT_PUBLIC_MAP_STYLE_URL=/tiles/jaipur.json
NEXT_PUBLIC_DEMO_MODE=true
