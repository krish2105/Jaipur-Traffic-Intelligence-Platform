# Refuse to run on the wrong Node rather than failing strangely later.
#
# On Node 20 the web suite dies inside undici with
# "webidl.util.markAsUncloneable is not a function", which names neither Node
# nor this project and cost a diagnosis the evening before a demo. package.json
# already says >=24.15.0 and .nvmrc says 24; this makes pnpm enforce it.
engine-strict=true
